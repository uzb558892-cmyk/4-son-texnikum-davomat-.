# ==========================================================================
# 4-SON TEXNIKUM DAVOMAT — muhit o‘zgaruvchilari
# Bu fayl NAMUNA. Nusxa oling: cp .env.example .env  (.env ni git'ga qo‘shmang!)
# Hech qanday kalit to‘qib chiqarilmagan — barcha qiymatlar BO‘SH.
# ==========================================================================

# --- FRONTEND UCHUN (ochiq bo‘lishi xavfsiz) --------------------------------
# Supabase Dashboard -> Project Settings -> API -> "Project URL"
SUPABASE_URL=
# Supabase Dashboard -> Project Settings -> API -> "anon" / "publishable" kalit
# (RLS himoyasi ostida; frontendga berilishi mumkin)
SUPABASE_ANON_KEY=

# --- FAQAT SERVER (HECH QACHON frontendga bermang!) ---------------------------
# Supabase Dashboard -> Project Settings -> API -> "service_role" / "secret" kalit.
# Edge Function'larda u avtomatik mavjud; faqat lokal skriptlar uchun kerak bo‘lsa to‘ldiring.
SUPABASE_SERVICE_ROLE_KEY=

# bootstrap-admin funksiyasini himoyalovchi maxfiy kalit (kamida 24 belgi).
# O‘zingiz yarating:  openssl rand -hex 32
# Supabase'ga yuklash: supabase secrets set BOOTSTRAP_SECRET=<qiymat>
BOOTSTRAP_SECRET=

# (ixtiyoriy) Edge Function CORS uchun frontend manzili, masalan https://davomat.example.uz
# Supabase'ga yuklash: supabase secrets set ALLOWED_ORIGIN=<manzil>
ALLOWED_ORIGIN=

# --- Supabase CLI (loyihani ulash uchun) ----------------------------------------
# Dashboard -> Project Settings -> General -> "Reference ID"
SUPABASE_PROJECT_REF=
