{
  "name": "4-son-texnikum-backend",
  "version": "1.0.0",
  "private": true,
  "description": "4-SON TEXNIKUM DAVOMAT — Supabase backend (migratsiyalar, RLS, Edge Functions) va TypeScript klient qatlami",
  "type": "module",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "gen:types": "supabase gen types typescript --local > src/types/database.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
