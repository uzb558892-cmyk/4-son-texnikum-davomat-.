# Frontend (Vercel yoki lokal .env) — faqat public qiymatlar
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
VITE_DEMO_MODE=false

# Supabase Edge Function secrets — faqat Supabase server tomonida sozlanadi.
# Ushbu qiymatlarni frontend/.env ga ko'chirmang.
BOOTSTRAP_SECRET=GENERATE_WITH_openssl_rand_hex_32
ALLOWED_ORIGIN=https://YOUR-PRODUCTION-DOMAIN

# Supabase CLI uchun (lokal shell muhiti; Vercel frontend env emas)
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
