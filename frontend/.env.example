# Supabase loyihangiz sozlamalaridan oling (Project Settings -> API).
# FAQAT "anon" (public) kalitni qo'ying. service_role kalitini HECH QACHON frontendga qo'ymang.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Majburan demo rejimini yoqish (true/false). Kalitlar bo'sh bo'lsa demo avtomatik yoqiladi.
VITE_DEMO_MODE=false
